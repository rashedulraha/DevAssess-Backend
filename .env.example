NODE_ENV=development
PORT=5000

# PostgreSQL (Neon Cloud Database)
DATABASE_URL="postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/devassess?sslmode=require"

# JWT Secrets
JWT_ACCESS_SECRET="devassess_jwt_access_secret_key_super_secure_32_chars"
JWT_REFRESH_SECRET="devassess_jwt_refresh_secret_key_super_secure_32_chars"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="30d"
BCRYPT_SALT_ROUNDS="12"

# Google OAuth (GCP Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Redis Cloud (TLS Enabled)
REDIS_URL="rediss://default:password@your-redis-cloud-endpoint:6379"

# Cloudinary File Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Payment Gateway (SSLCommerz Sandbox & Stripe Test Mode)
SSL_STORE_ID="testbox"
SSL_STORE_PASS="qwerty"
SSL_IS_LIVE="false"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
BACKEND_PUBLIC_URL="http://localhost:5000"
FRONTEND_PUBLIC_URL="http://localhost:3000"

# SMTP Email (Gmail App Password or Resend)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-digit-app-password"
