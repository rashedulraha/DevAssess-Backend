datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum ProblemType {
  MCQ
  WRITTEN
  CODING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
  EVALUATED
  FLAGGED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  googleId     String?   @unique
  fullName     String
  role         Role      @default(CANDIDATE)
  avatarUrl    String?
  resumeUrl    String?
  bio          String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company     Company?
  invitations CandidateInvitation[]
  attempts    AssessmentAttempt[]
  evaluations Submission[]          @relation("EvaluatedBy")
  auditLogs   AuditLog[]

  @@index([email])
  @@index([role, isActive])
}

model Company {
  id                String    @id @default(uuid())
  ownerId           String    @unique
  name              String
  slug              String    @unique
  logoUrl           String?
  website           String?
  industry          String?
  assessmentCredits Int       @default(0)
  planTier          String    @default("FREE")
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  owner       User         @relation(fields: [ownerId], references: [id])
  problems    Problem[]
  assessments Assessment[]
  payments    Payment[]

  @@index([slug])
}

model Problem {
  id          String      @id @default(uuid())
  companyId   String
  title       String
  description String
  type        ProblemType
  difficulty  Difficulty
  tags        String[]
  options     Json? // For MCQ: [{ id: "A", text: "...", isCorrect: true }]
  starterCode Json? // For CODING: { javascript: "...", python: "..." }
  testCases   Json? // For CODING: [{ input: "...", expectedOutput: "...", isHidden: true }]
  maxScore    Int         @default(10)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company     Company             @relation(fields: [companyId], references: [id])
  assessments AssessmentProblem[]
  submissions Submission[]

  @@index([companyId, type, difficulty])
  @@index([deletedAt])
}

model Assessment {
  id              String           @id @default(uuid())
  companyId       String
  title           String
  description     String?
  durationMinutes Int              @default(60)
  passingScore    Int              @default(70)
  totalPoints     Int              @default(100)
  status          AssessmentStatus @default(DRAFT)
  maxTabSwitches  Int              @default(3)
  startAt         DateTime?
  endAt           DateTime?
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company     Company               @relation(fields: [companyId], references: [id])
  problems    AssessmentProblem[]
  invitations CandidateInvitation[]
  attempts    AssessmentAttempt[]

  @@index([companyId, status])
  @@index([deletedAt])
}

model AssessmentProblem {
  id           String  @id @default(uuid())
  assessmentId String
  problemId    String
  orderIndex   Int     @default(1)
  customPoints Int?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  problem    Problem    @relation(fields: [problemId], references: [id])

  @@unique([assessmentId, problemId])
}

model CandidateInvitation {
  id             String           @id @default(uuid())
  assessmentId   String
  candidateEmail String
  candidateId    String?
  inviteToken    String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  sentAt         DateTime         @default(now())
  acceptedAt     DateTime?

  assessment Assessment         @relation(fields: [assessmentId], references: [id])
  candidate  User?              @relation(fields: [candidateId], references: [id])
  attempt    AssessmentAttempt?

  @@unique([assessmentId, candidateEmail])
  @@index([inviteToken])
  @@index([candidateEmail, status])
}

model AssessmentAttempt {
  id              String        @id @default(uuid())
  invitationId    String        @unique
  assessmentId    String
  candidateId     String
  status          AttemptStatus @default(IN_PROGRESS)
  startedAt       DateTime      @default(now())
  expiresAt       DateTime
  submittedAt     DateTime?
  evaluatedAt     DateTime?
  totalScore      Float         @default(0)
  percentageScore Float         @default(0)
  isPassed        Boolean       @default(false)
  tabSwitchCount  Int           @default(0)
  ipAddress       String?

  invitation    CandidateInvitation @relation(fields: [invitationId], references: [id])
  assessment    Assessment          @relation(fields: [assessmentId], references: [id])
  candidate     User                @relation(fields: [candidateId], references: [id])
  submissions   Submission[]
  antiCheatLogs AntiCheatLog[]

  @@index([assessmentId, status])
  @@index([candidateId])
}

model Submission {
  id              String   @id @default(uuid())
  attemptId       String
  problemId       String
  selectedOption  String? // For MCQ
  writtenAnswer   String? // For WRITTEN
  sourceCode      String? // For CODING
  language        String? // e.g., "typescript", "python"
  passedTestCases Int      @default(0)
  totalTestCases  Int      @default(0)
  awardedScore    Float    @default(0)
  isAutoEvaluated Boolean  @default(false)
  evaluatorId     String?
  evaluatorNotes  String?
  submittedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  problem   Problem           @relation(fields: [problemId], references: [id])
  evaluator User?             @relation("EvaluatedBy", fields: [evaluatorId], references: [id])

  @@unique([attemptId, problemId])
}

model AntiCheatLog {
  id        String   @id @default(uuid())
  attemptId String
  eventType String // "TAB_SWITCH", "WINDOW_BLUR", "FULLSCREEN_EXIT", "COPY_PASTE"
  metadata  Json?
  createdAt DateTime @default(now())

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, eventType])
}

model Payment {
  id                String        @id @default(uuid())
  companyId         String
  provider          String // "STRIPE" | "SSLCOMMERZ" | "BKASH"
  transactionId     String        @unique
  gatewaySessionId  String?
  amount            Float
  currency          String        @default("BDT")
  creditsPurchased  Int
  status            PaymentStatus @default(PENDING)
  rawWebhookPayload Json?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([transactionId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String // e.g., "USER_ROLE_UPDATED", "PAYMENT_VERIFIED", "ATTEMPT_FLAGGED"
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
