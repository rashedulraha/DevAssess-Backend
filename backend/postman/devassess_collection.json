      "description": "Timed assessment attempt initiation, Redis timer synchronization, anti-cheat telemetry, and auto-evaluation.",
      "item": [
        {
          "name": "Start Timed Attempt (Sanitized Questions)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.attempt) {",
                  "    pm.environment.set(\"attemptId\", jsonData.data.attempt.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invitationToken\": \"{{invitationToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attempts/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attempts",
                "start"
              ]
            },
            "description": "Calculates expiresAt = startedAt + durationMinutes, sets Redis TTL, marks invitation as ACCEPTED, and returns sanitized problem set (hiding MCQ answers & secret test cases)."
          }
        },
        {
          "name": "Submit Coding Problem Solution",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set(\"submissionId\", jsonData.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"problemId\": \"{{problemId}}\",\n  \"codeAnswer\": \"function twoSum(nums, target) {\\n  const map = new Map();\\n  for (let i = 0; i < nums.length; i++) {\\n    const complement = target - nums[i];\\n    if (map.has(complement)) {\\n      return [map.get(complement), i];\\n    }\\n    map.set(nums[i], i);\\n  }\\n  return [];\\n}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attempts/{{attemptId}}/submissions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attempts",
                "{{attemptId}}",
                "submissions"
              ]
            },
            "description": "Executes candidate code in an isolated Node.js vm sandbox with memory & execution timeout limits. Returns passed test cases and calculated score."
          }
        },
        {
          "name": "Report Anti-Cheat Telemetry Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{candidateToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"TAB_SWITCH\",\n  \"metadata\": {\n    \"blurTimestamp\": \"2026-10-15T23:51:06.780Z\",\n    \"userAgent\": \"Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)\",\n    \"windowFocus\": false\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attempts/{{attemptId}}/anti-cheat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attempts",
                "{{attemptId}}",
                "anti-cheat"
              ]
            },
            "description": "Logs telemetry event and increments tabSwitchCount. Automatically sets attempt.isFlagged = true if limit exceeded."
          }
        },
        {
