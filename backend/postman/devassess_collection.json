              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{recruiterToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Two Sum Optimal Search\",\n  \"description\": \"Given an array of integers nums and an integer target, return indices of the two numbers such that they add up to target.\\n\\nYou may assume that each input would have exactly one solution, and you may not use the same element twice.\",\n  \"type\": \"CODING\",\n  \"difficulty\": \"EASY\",\n  \"points\": 20,\n  \"tags\": [\n    \"array\",\n    \"hash-table\",\n    \"algorithms\"\n  ],\n  \"starterCode\": \"function twoSum(nums, target) {\\n  // Write your optimal solution here\\n}\",\n  \"testCases\": [\n    {\n      \"input\": \"[2,7,11,15]\\n9\",\n      \"expectedOutput\": \"[0,1]\",\n      \"isHidden\": false,\n      \"points\": 10\n    },\n    {\n      \"input\": \"[3,2,4]\\n6\",\n      \"expectedOutput\": \"[1,2]\",\n      \"isHidden\": true,\n      \"points\": 10\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/problems",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "problems"
              ]
            }
          }
        },
        {
          "name": "Create Problem - MCQ",
