                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/attempts/{{attemptId}}/finalize",
              "host": [
                "{{baseUrl}}"
