            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Node.js Event Loop Microtasks\",\n  \"description\": \"Which of the following queues executes first in Node.js event loop cycle when both have pending callbacks?\",\n  \"type\": \"MCQ\",\n  \"difficulty\": \"MEDIUM\",\n  \"points\": 10,\n  \"tags\": [\n    \"nodejs\",\n    \"javascript\",\n    \"concurrency\"\n  ],\n  \"options\": [\n    {\n      \"text\": \"process.nextTick() queue\",\n      \"isCorrect\": true\n    },\n    {\n      \"text\": \"Promise.then() microtask queue\",\n      \"isCorrect\": false\n    },\n    {\n      \"text\": \"setImmediate() check queue\",\n      \"isCorrect\": false\n    },\n    {\n      \"text\": \"setTimeout() timer queue\",\n      \"isCorrect\": false\n    }\n  ]\n}"
            },
